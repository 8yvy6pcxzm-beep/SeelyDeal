# ─────────────────────────────────────────────────────────────────────────────
#  .env.example  —  copy to .env.local and fill in.
#
#  The guided setup ("/setup" in Claude Code) does this FOR you: it asks which
#  integrations you want, collects each key, and writes .env.local.
#
#  Every key here is OPTIONAL. With none set, Tender runs in DEMO MODE with
#  realistic sample proposals, clients and view events so you can see it
#  immediately.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (database & auth) ───────────────────────────────────────────────
# Proposals, clients and view events. https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Dropbox Sign / HelloSign (e-signature) ───────────────────────────────────
# Legally binding signatures inside each proposal. https://app.hellosign.com/home/myAccount#api
DROPBOX_SIGN_API_KEY=

# ── Stripe (charge accepted proposals) ───────────────────────────────────────
# Collect deposits / payment the moment a client signs. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Anthropic (AI proposal drafting) ─────────────────────────────────────────
# Powers AI drafting & section rewrites. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
