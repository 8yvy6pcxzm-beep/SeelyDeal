# ─────────────────────────────────────────────────────────────────────────────
#  .env.example  —  copy to .env.local and fill in.
#
#  The guided setup ("/setup" in Claude Code) does this FOR you: it asks which
#  integrations you want, collects each key, and writes .env.local.
#
#  Without NEXT_PUBLIC_SUPABASE_URL / ANON_KEY set, SeelyDeal falls back to
#  DEMO MODE with realistic sample proposals, clients and view events so you
#  can see it immediately. Once those are set, the app runs on a real
#  Supabase project (real auth, real data) — that's the normal state for a
#  deployed SeelyDeal instance.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (database & auth) ───────────────────────────────────────────────
# Proposals, clients, team, e-sign audit and view events; email/password +
# Google/GitHub OAuth. Run `supabase/schema.sql` + `supabase/migrations/*` on
# a fresh project first. https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Client data encryption ────────────────────────────────────────────────────
# 32-byte key, base64-encoded, used by lib/crypto.ts to encrypt client PII at
# rest. Generate with: openssl rand -base64 32
CLIENT_DATA_ENCRYPTION_KEY=

# ── Resend (transactional email) ─────────────────────────────────────────────
# Sends e-sign OTP codes and proposal reminder emails. https://resend.com/api-keys
RESEND_API_KEY=

# ── Dropbox Sign / HelloSign (e-signature) ───────────────────────────────────
# Reserved for a future Dropbox Sign API integration — SeelyDeal's e-sign flow
# today is a self-hosted OTP-verified signature (see app/api/proposals/[id]/sign),
# this key is not yet read by any route. https://app.hellosign.com/home/myAccount#api
DROPBOX_SIGN_API_KEY=

# ── Stripe (charge accepted proposals) ───────────────────────────────────────
# Not yet integrated — reserved for future checkout/webhook support to collect
# deposits or payment the moment a client signs. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Anthropic (AI proposal drafting) ─────────────────────────────────────────
# Powers Seely's AI drafting & section rewrites. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
